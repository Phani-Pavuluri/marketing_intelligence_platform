{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mip.local/schemas/work_plan_v1.json",
  "title": "MIP bounded work plan v1 (proposal only)",
  "description": "Structural schema for a bounded work plan proposal. A valid plan never authorizes execution; cross-task rules (dependency cycles, overlapping owned paths, deterministic ordering) are enforced by the work_plan validator, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "plan_id", "goal", "exclusions", "tasks"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Plan schema version. Booleans are not accepted as integers."
    },
    "repository": {
      "type": "string",
      "const": "Phani-Pavuluri/marketing_intelligence_platform"
    },
    "plan_id": {
      "$ref": "#/$defs/stable_id"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "Nonempty, non-whitespace goal text."
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
      "description": "Starts with a letter; A-Z, 0-9, underscore; at most 128 characters."
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "feature_branch",
        "outcome",
        "observable_behavior",
        "owned_paths",
        "acceptance_evidence",
        "risk_tier",
        "depends_on",
        "unresolved_design_questions"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/stable_id" },
        "feature_branch": {
          "type": "string",
          "minLength": 1,
          "description": "Valid Git branch name that is not 'main'."
        },
        "outcome": { "type": "string", "minLength": 1 },
        "observable_behavior": { "type": "string", "minLength": 1 },
        "owned_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptance_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_tier": {
          "type": "integer",
          "enum": [1, 2, 3]
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "unresolved_design_questions": {
          "type": "array",
          "maxItems": 0,
          "description": "Must be empty for a valid proposal."
        }
      }
    }
  }
}
